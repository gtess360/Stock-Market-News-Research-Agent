# ==============================================================================
# Stock Market News Research Agent - Environment Configuration Template
# Copy this file to .env and populate with appropriate values.
# NEVER commit actual credentials or the .env file to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Storage / Database (SQLite default for initial prototype)
DATABASE_URL=sqlite:///./data/app.db

# LLM Orchestrator Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Market and Financial News Provider Credentials (To be selected/configured in Phase 3)
# FINNHUB_API_KEY=your_finnhub_key_here
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# POLYGON_API_KEY=your_polygon_key_here

# Administrative Security & Secrets
ADMIN_SECRET_KEY=your_secure_admin_signing_key_here
SESSION_SECRET=your_secure_session_secret_here

# Free Tier & Concurrency Limits
FREE_TIER_JOB_LIMIT=3
MAX_TICKERS_PER_JOB=5

